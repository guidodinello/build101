ENV=local

# Supabase (ADR 0003). DATABASE_URL is the session pooler, with the asyncpg driver:
# postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_URL=
# Backend only, never in the frontend
SUPABASE_SERVICE_ROLE_KEY=

# The web wizard (T24): magic links point to FRONTEND_URL; FRONTEND_ORIGINS is the CORS list
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
# The bot's number, digits only, for the wa.me link on the wizard's last screen
WHATSAPP_BOT_NUMBER=

# /dev/* endpoints (POST /dev/onboarding-link), called with the header X-Dev-Token: $DEV_TOKEN
ENABLE_DEV_ENDPOINTS=false
DEV_TOKEN=
# Only for the onboarding API tests: a Postgres they can wipe (see docs/implementation/setup.md)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/build101_test

# Image generation (ADR 0018, 0019, 0022). IMAGE_GEN = gemini | openai | mock
IMAGE_GEN=mock
# From a Google project with billing linked: unpaid use trains on the images
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_THINKING_LEVEL=medium
# 1K | 2K | 4K. Posts end up 1080x1350 either way
GEMINI_IMAGE_SIZE=2K
IMAGE_GEN_MAX_CONCURRENCY=4

# Replies to the Owner (ADR 0023), same GEMINI_API_KEY. INBOUND_HANDLER = chat | echo (no LLM)
INBOUND_HANDLER=chat
GEMINI_CHAT_MODEL=gemini-3.8-flash
ASSISTANT_NAME=Mora
# Where WhatsApp fetches the post images: the Railway domain, or the ngrok/cloudflared URL locally
PUBLIC_BACKEND_URL=
# Designs (posts with AI-generated images) a sender can start per day; posts of the photos as
# they are don't count. Past it create_post answers daily_limit
MAX_POSTS_PER_DAY=5
# Photos over it get a fixed reply instead of being downloaded
MAX_PHOTO_MB=10

# WhatsApp through Kapso (ADR 0020). WHATSAPP_CHANNEL = kapso | simulator (simulator is T21)
WHATSAPP_CHANNEL=kapso
# Kapso project API key, sent as X-API-Key
KAPSO_API_KEY=
# Signing secret of the webhook; the HMAC-SHA256 of the raw body arrives in X-Webhook-Signature
KAPSO_WEBHOOK_SECRET=
# The number we send from: the sandbox now, the free US number later
KAPSO_PHONE_NUMBER_ID=
# Only for `uv run pytest -m live`: a verified recipient, and a media id from an inbound message
# KAPSO_TEST_RECIPIENT=
# KAPSO_TEST_MEDIA_ID=

# Publishing through Zernio (ADR 0008). PUBLISHER = zernio | mock (mock never posts)
PUBLISHER=mock
ZERNIO_API_KEY=
# The single demo Instagram account (ADR 0024); temporary until social_accounts exists
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=
# Only for `uv run pytest -m live`: public HTTPS URL of tests/fixtures/zernio-live-test.jpg (see docs/implementation/setup.md)
# ZERNIO_TEST_IMAGE_URL=
