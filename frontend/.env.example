# Backend base URL (FastAPI). For the in-app mock backend use http://localhost:3000/mock-api
NEXT_PUBLIC_API_URL=http://localhost:8000
# wa.me link to the bot: the landing page CTAs and the expired-link screen
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/56920403095
# Serve the dev-only mock of the onboarding API at /mock-api (never in production)
ENABLE_MOCK_API=false
# Shared secret the backend sends to POST /api/render (its RENDERER_SECRET)
RENDER_SECRET=
# Serve the post template preview at /dev/post-templates (never in production)
ENABLE_TEMPLATE_PREVIEW=false
